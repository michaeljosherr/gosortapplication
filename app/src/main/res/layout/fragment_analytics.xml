<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Analytics"
                android:textSize="28sp"
                android:textColor="#2C3E50"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_analytics"
                android:layout_gravity="center_vertical" />

        </LinearLayout>

        <!-- Performance Overview -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Performance Overview"
                    android:textSize="18sp"
                    android:textColor="#2C3E50"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Concentric donut view -->
                <com.example.gosortapplication.ConcentricDonutView
                    android:id="@+id/concentricDonut"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="12dp" />

                <!-- Bin Legend (5 categories) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                        <!-- Biodegradable -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="#F39C12" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Biodegradable"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/poppins" />

                            <TextView
                                android:id="@+id/tvBiodeg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="70%"
                                android:fontFamily="@font/poppins" />

                        </LinearLayout>

                        <!-- Non-Biodegradable -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="#4A90E2" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Non- Biodegradable"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/poppins" />

                            <TextView
                                android:id="@+id/tvNonBiodeg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="45%"
                                android:fontFamily="@font/poppins" />

                        </LinearLayout>

                        <!-- Mixed Waste -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="#27AE60" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Mixed Waste"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/poppins" />

                            <TextView
                                android:id="@+id/tvMixed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="85%"
                                android:fontFamily="@font/poppins" />

                        </LinearLayout>

                        <!-- Unidentified -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="#F7E34A" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Unidentified Waste"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/poppins" />

                            <TextView
                                android:id="@+id/tvUnidentified"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30%"
                                android:fontFamily="@font/poppins" />

                        </LinearLayout>

                        <!-- Hazardous -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="#E74C3C" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Hazardous Waste"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/poppins" />

                            <TextView
                                android:id="@+id/tvHazardous"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5%"
                                android:fontFamily="@font/poppins" />

                        </LinearLayout>

                    </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Sort Types -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sort Algorithm Usage"
                    android:textSize="18sp"
                    android:textColor="#2C3E50"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Quick Sort -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quick Sort"
                        android:textSize="14sp"
                        android:textColor="#2C3E50" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="65%"
                        android:textSize="14sp"
                        android:textColor="#4A90E2"
                        android:textStyle="bold" />

                </LinearLayout>

                <ProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="65"
                    android:progressTint="#4A90E2"
                    android:layout_marginBottom="16dp"
                    style="?android:attr/progressBarStyleHorizontal" />

                <!-- Merge Sort -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Merge Sort"
                        android:textSize="14sp"
                        android:textColor="#2C3E50" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25%"
                        android:textSize="14sp"
                        android:textColor="#27AE60"
                        android:textStyle="bold" />

                </LinearLayout>

                <ProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="25"
                    android:progressTint="#27AE60"
                    android:layout_marginBottom="16dp"
                    style="?android:attr/progressBarStyleHorizontal" />

                <!-- Bubble Sort -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bubble Sort"
                        android:textSize="14sp"
                        android:textColor="#2C3E50" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10%"
                        android:textSize="14sp"
                        android:textColor="#F39C12"
                        android:textStyle="bold" />

                </LinearLayout>

                <ProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="10"
                    android:progressTint="#F39C12"
                    style="?android:attr/progressBarStyleHorizontal" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Weekly Activity -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weekly Activity"
                    android:textSize="18sp"
                    android:textColor="#2C3E50"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:baselineAligned="false">

                    <!-- Day 0 (6 days ago) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">

                        <View
                            android:id="@+id/bar_day0"
                            android:layout_width="24dp"
                            android:layout_height="80dp"
                            android:background="#4A90E2"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/label_day0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="#7F8C8D"
                            android:text="Mon"/>
                    </LinearLayout>

                    <!-- Day 1 (5 days ago) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">

                        <View
                            android:id="@+id/bar_day1"
                            android:layout_width="24dp"
                            android:layout_height="60dp"
                            android:background="#4A90E2"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/label_day1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="#7F8C8D"
                            android:text="Tue"/>
                    </LinearLayout>

                    <!-- Day 2 (4 days ago) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">

                        <View
                            android:id="@+id/bar_day2"
                            android:layout_width="24dp"
                            android:layout_height="100dp"
                            android:background="#4A90E2"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/label_day2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="#7F8C8D"
                            android:text="Wed"/>
                    </LinearLayout>

                    <!-- Day 3 (3 days ago) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">

                        <View
                            android:id="@+id/bar_day3"
                            android:layout_width="24dp"
                            android:layout_height="40dp"
                            android:background="#4A90E2"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/label_day3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="#7F8C8D"
                            android:text="Thu"/>
                    </LinearLayout>

                    <!-- Day 4 (2 days ago) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">

                        <View
                            android:id="@+id/bar_day4"
                            android:layout_width="24dp"
                            android:layout_height="90dp"
                            android:background="#4A90E2"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/label_day4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="#7F8C8D"
                            android:text="Fri"/>
                    </LinearLayout>

                    <!-- Day 5 (yesterday) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">

                        <View
                            android:id="@+id/bar_day5"
                            android:layout_width="24dp"
                            android:layout_height="70dp"
                            android:background="#4A90E2"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/label_day5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="#7F8C8D"
                            android:text="Sat"/>
                    </LinearLayout>

                    <!-- Day 6 (today) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">

                        <View
                            android:id="@+id/bar_day6"
                            android:layout_width="24dp"
                            android:layout_height="85dp"
                            android:background="#4A90E2"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/label_day6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="#7F8C8D"
                            android:text="Sun"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
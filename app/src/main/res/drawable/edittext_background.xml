<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state - with green outline -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/textbox_background"/>
            <stroke android:width="2dp" android:color="#14AE31"/>
            <corners android:radius="8dp"/>
            <padding android:left="16dp" android:right="16dp" android:top="12dp" android:bottom="12dp"/>
        </shape>
    </item>
    
    <!-- Default state - no outline -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/textbox_background"/>
            <corners android:radius="8dp"/>
            <padding android:left="16dp" android:right="16dp" android:top="12dp" android:bottom="12dp"/>
        </shape>
    </item>
</selector>